      "site_label": "Vatican City, including St Peter's Basilica and the Sistine Chapel.",
      "history_points": [
        {
          "fact_id": "vatican-20min:C02",
          "episode_id": "vatican-20min",
          "claim_id": "C02",
          "text": "Vatican City grew from the site of St Peter's tomb and basilica and the papal palace to a sovereign state in 1929.",
          "source": "https://en.wikipedia.org/wiki/Vatican_City",
          "uncertainty": null
        },
        {
          "fact_id": "vatican-20min:C08",
          "episode_id": "vatican-20min",
          "claim_id": "C08",
          "text": "Constantine ordered Old St Peter's built (begun c.318-322) with the altar over the monument believed to be Peter's grave.",
          "source": "https://en.wikipedia.org/wiki/Old_St._Peter%27s_Basilica",
          "uncertainty": "Start date range 318-333 in sources"
        },
        {
          "fact_id": "ep01-vatican:C11",
          "episode_id": "ep01-vatican",
          "claim_id": "C11",
          "text": "The Lateran Pacts were signed on 11 February 1929 by Cardinal Pietro Gasparri for the Holy See and Benito Mussolini for the Kingdom of Italy.",
          "source": "https://www.vatican.va/roman_curia/secretariat_state/archivio/documents/rc_seg-st_19290211_patti-lateranensi_it.html",
          "uncertainty": "Britannica's quick facts list Borgongini-Duca and Boselli as 'key people'; negotiators included Francesco Pacelli (not yet sourced). Signing location (Lateran Palace) not yet sourced."
        },
        {
          "fact_id": "conclave-20min:C19",
          "episode_id": "conclave-20min",
          "claim_id": "C19",
          "text": "Sixtus IV built the Sistine Chapel 1473–81; first conclave there Aug 1492 (6–11 Aug) elected Rodrigo Borgia (Alexander VI), notorious for allegations of vote-buying; Julius II later enacted stronger anti-simony rules.",
          "source": "https://en.wikipedia.org/wiki/1492_papal_conclave",
          "uncertainty": "Bribery 'alleged'/'almost certainly' — not proven"
        },
        {
          "fact_id": "conclave-20min:C35",
          "episode_id": "conclave-20min",
          "claim_id": "C35",
          "text": "Michelangelo painted the Sistine ceiling (1508–12) and the Last Judgement (1536–41).",
          "source": "https://en.wikipedia.org/wiki/Sistine_Chapel",
          "uncertainty": "—"
        }
      ],
