          "episode_id": "pompeii-20min",
          "claim_id": "C02",
          "text": "Pompeii and Herculaneum were buried under metres of ash and pumice and lay hidden until the 18th c.",
          "source": "https://en.wikipedia.org/wiki/Pompeii",
          "uncertainty": null
        },
        {
          "fact_id": "pompeii-20min:C14",
          "episode_id": "pompeii-20min",
          "claim_id": "C14",
          "text": "Vesuvius had not erupted in living memory; Pliny the Younger's two letters to Tacitus are the only surviving eyewitness account",
          "source": "https://en.wikipedia.org/wiki/Eruption_of_Mount_Vesuvius_in_79_AD",
          "uncertainty": null
        },
        {
          "fact_id": "pompeii-20min:C29",
          "episode_id": "pompeii-20min",
          "claim_id": "C29",
          "text": "Traditional date 24 Aug from manuscripts; manuscripts vary (Aug 24 / Oct 30 / Nov 1 / Nov 23)",
          "source": "https://en.wikipedia.org/wiki/Eruption_of_Mount_Vesuvius_in_79_AD",
          "uncertainty": "Debate ongoing"
        }
      ],
