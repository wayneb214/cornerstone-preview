      "map_points": [
        {
          "name": "Florence Cathedral",
          "latitude": 43.77315,
          "longitude": 11.256
        }
      ],
      "site_label": "The cathedral of Santa Maria del Fiore, the Duomo of Florence.",
      "history_points": [
        {
          "fact_id": "duomo-20min:C01",
          "episode_id": "duomo-20min",
          "claim_id": "C01",
          "text": "The new cathedral was begun in 1296 to a design by Arnolfo di Cambio, replacing Santa Reparata.",
          "source": "https://duomo.firenze.it/en/opera-magazine/post/4436/the-dome-s-construction-work-begins-on-august-7th-1420",
          "uncertainty": "Whether Arnolfo planned a dome of this size: 'not all historians agree' (Opera)"
        },
        {
          "fact_id": "duomo-20min:C02",
          "episode_id": "duomo-20min",
          "claim_id": "C02",
          "text": "In 1367 a model by Neri di Fioravanti (and a committee) was chosen over Giovanni di Lapo Ghini's; it fixed an octagonal dome about 45.5 m across.",
          "source": "https://duomo.firenze.it/en/opera-magazine/post/4436/the-dome-s-construction-work-begins-on-august-7th-1420",
          "uncertainty": "Columbia summary (search only) says the choice went to a citizens' referendum; names of the committee vary"
        },
        {
          "fact_id": "duomo-20min:C30",
          "episode_id": "duomo-20min",
          "claim_id": "C30",
          "text": "Pope Eugenius IV consecrated the cathedral on 25 March 1436.",
          "source": "http://archivio.operaduomo.fi.it/cupola/ENG/HTML/S021/C471/T001/TBLOCK00.HTM",
          "uncertainty": "Opera magazine says Eugene consecrated 'the Dome' on 30 Aug 1436 — conflict"
        },
        {
          "fact_id": "duomo-20min:C31",
          "episode_id": "duomo-20min",
          "claim_id": "C31",
          "text": "The dome itself was closed at the top on 30 August 1436.",
          "source": "https://duomo.firenze.it/en/opera-magazine/post/4649/on-30-august-1436-the-work-on-brunelleschi-s-dome-was-completed",
          "uncertainty": "Blessing that day often attributed to the Bishop of Fiesole (search only)"
        }
      ],
